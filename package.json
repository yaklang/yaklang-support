{
    "name": "yak",
    "displayName": "yaklang",
    "publisher": "v1ll4n",
    "description": "Yaklang Utils for VSCode",
    "version": "1.3.1",
    "engines": {
        "vscode": "^1.56.0"
    },
    "repository": "https://github.com/yaklang/yaklang-support",
    "categories": [
        "Programming Languages",
        "Extension Packs",
        "Snippets",
        "Language Packs"
    ],
    "activationEvents": [
        "onLanguage:yak",
        "onLanguage:syntaxflow"
    ],
    "icon": "images/icon.png",
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "yak.exec.file",
                "title": "Yak: Exec file",
                "description": "Exec Yak file"
            },
            {
                "command": "yak.debug.file",
                "title": "Yak: Debug file",
                "description": "Debug Yak file"
            },
            {
                "command": "yak.fmt.file",
                "title": "Yak: Format file",
                "description": "Format Yak file"
            },
            {
                "command": "yak.environment.status",
                "title": "Yak: 配置引擎",
                "description": "查看和配置 Yak 引擎版本"
            },
            {
                "command": "yaklang.lsp.showStatus",
                "title": "Yaklang: LSP 状态",
                "description": "查看 YAK LSP 服务器状态"
            },
            {
                "command": "yaklang.lsp.restart",
                "title": "Yaklang: 重启 LSP 服务器",
                "description": "强制重启 YAK LSP 服务器"
            },
            {
                "command": "yaklang.downloadEngine",
                "title": "Yaklang: 下载 Yak 引擎",
                "description": "下载指定版本的 Yak 引擎到 ~/.yak/bin"
            },
            {
                "command": "yaklang.listInstalledVersions",
                "title": "Yaklang: 查看已安装版本",
                "description": "查看所有已安装的 Yak 引擎版本"
            }
        ],
        "snippets": [
            {
                "language": "yak",
                "path": "./snippets/snippets.json"
            }
        ],
        "languages": [
            {
                "id": "yak",
                "aliases": [
                    "Yak",
                    "yak"
                ],
                "extensions": [
                    "yak"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "syntaxflow",
                "aliases": [
                    "SyntaxFlow",
                    "syntaxflow"
                ],
                "extensions": [
                    "sf"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "yak",
                "scopeName": "source.yak",
                "path": "./syntaxes/yak.tmLanguage.json"
            },
            {
                "language": "syntaxflow",
                "scopeName": "source.syntaxflow",
                "path": "./syntaxes/syntaxflow.tmLanguage.json"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "resourceFilename =~ /.yak$/",
                    "command": "yak.exec.file",
                    "group": "yak"
                },
                {
                    "when": "resourceFilename =~ /.yak$/",
                    "command": "yak.debug.file",
                    "group": "yak"
                },
                {
                    "when": "resourceFilename =~ /.yak$/",
                    "command": "yak.fmt.file",
                    "group": "yak"
                }
            ]
        },
        "configuration": {
            "title": "Yaklang",
            "properties": {
                "yaklang.yakBinarySource": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "custom"
                    ],
                    "enumDescriptions": [
                        "Automatically use yak from system PATH",
                        "Use custom yak binary path (select via status bar)"
                    ],
                    "default": "auto",
                    "description": "Choose how to locate yak binary: 'auto' uses system PATH, 'custom' uses manually specified path"
                },
                "yaklang.yakBinaryPath": {
                    "type": "string",
                    "default": "",
                    "description": "Custom path to yak binary (only used when yakBinarySource is 'custom')"
                }
            }
        },
        "keybindings": [
            {
                "command": "yak.exec.file",
                "key": "ctrl+shift+b",
                "mac": "cmd+shift+b",
                "when": "editorFocus && resourceFilename =~ /.yak$/"
            }
        ],
        "breakpoints": [
            {
                "language": "yak"
            }
        ],
        "debuggers": [
            {
                "type": "yak",
                "languages": [
                    "yak"
                ],
                "label": "Yaklang Debug",
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Absolute path to a text file.",
                                "default": "${file}"
                            },
                            "debug": {
                                "type": "boolean",
                                "description": "enable debug for debugger adapter",
                                "default": false
                            },
                            "args": {
                                "type": "array",
                                "description": "Arguments passed to the program.",
                                "items": {
                                    "type": "string"
                                },
                                "default": []
                            },
                            "env": {
                                "type": "array",
                                "description": "Environments passed to the program.",
                                "items": {
                                    "type": "string"
                                },
                                "default": []
                            },
                            "host": {
                                "type": "string",
                                "description": "debugger adapter host"
                            },
                            "port": {
                                "type": "number",
                                "description": "debugger adapter port"
                            }
                        }
                    }
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "lint": "eslint . --ext .ts,.tsx",
        "watch": "tsc -watch -p ./",
        "publish": "vsce publish"
    },
    "dependencies": {
        "axios": "^1.6.0",
        "vscode-languageclient": "^7.0.0"
    },
    "devDependencies": {
        "@types/node": "^12.12.0",
        "@types/vscode": "^1.32.0",
        "@typescript-eslint/eslint-plugin": "^4.16.0",
        "@typescript-eslint/parser": "^4.16.0",
        "eslint": "^7.21.0",
        "typescript": "^4.3.2",
        "vsce": "^1.100.0",
        "vscode-debugadapter": "^1.51.0",
        "vscode-debugprotocol": "^1.51.0"
    }
}